// use prisma-next
model User {
  id            String               @id
  name          String
  email         String               @unique
  emailVerified Boolean
  image         String?
  createdAt     TimestamptzString(3)
  updatedAt     TimestamptzString(3)
  workflows     Workflow[]

  @@map("user")
}

model Session {
  id        String               @id
  user      User                 @relation(fields:[userId], references:[id])
  userId    String
  token     String               @unique
  expiresAt TimestamptzString(3)
  ipAddress String?
  userAgent String?
  createdAt TimestamptzString(3)
  updatedAt TimestamptzString(3)

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Account {
  id                    String                @id
  user                  User                  @relation(fields:[userId], references:[id])
  userId                String
  issuer                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  TimestamptzString(3)?
  refreshTokenExpiresAt TimestamptzString(3)?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             TimestamptzString(3)
  updatedAt             TimestamptzString(3)

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model Verification {
  id         String               @id
  identifier String
  value      String
  expiresAt  TimestamptzString(3)
  createdAt  TimestamptzString(3)
  updatedAt  TimestamptzString(3)

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

model Workflow {
  id        String           @id @default(cuid(2))
  name      String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}
