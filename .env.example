# Copy to `.env` and replace placeholders with real values.

# Database (PostgreSQL >= 15, e.g. Neon pooled connection)
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Better Auth
BETTER_AUTH_SECRET="..."
BETTER_AUTH_URL="http://localhost:3000"

# Inngest
INNGEST_DEV=1

# AI Providers
GOOGLE_GENERATIVE_AI_API_KEY="dummy-google-api-key"
ANTHROPIC_API_KEY="dummy-anthropic-api-key"
OPENAI_API_KEY="dummy-openai-api-key"

# Sentry
NEXT_PUBLIC_SENTRY_DSN="..."
SENTRY_ORG="..."
SENTRY_PROJECT="..."
SENTRY_AUTH_TOKEN="..."

# Polar
POLAR_ACCESS_TOKEN="..."
POLAR_SUCCESS_URL=http://localhost:3000
POLAR_PRODUCT_ID="..."
POLAR_SERVER=sandbox

# Encryption
ENCRYPTION_KEY="your-encryption-key"

# Other
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NGROK_URL="https://your-ngrok-url.dev"
